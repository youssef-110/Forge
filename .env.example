# Copy to .env (git-ignored) and fill in. Read by docker compose and by the agent CLI.

# LLM for the agent and the eval judge. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: other providers (install the matching extra, e.g. pip install -e ".[anthropic]")
# MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=
MODEL=groq:llama-3.3-70b-versatile
JUDGE_MODEL=groq:llama-3.3-70b-versatile

# Optional: Langfuse tracing of agent runs
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
